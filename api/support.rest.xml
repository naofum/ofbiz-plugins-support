<!-- Customer support API contract. It is not published until efinance's JWT
     authentication and EfAccessGuard are in place. Enable by setting
     publish="true" or expose the same services from efinance. -->
<api name="support" displayName="Support" description="Customer support cases"
     publish="false">
    <resource name="cases" path="/support/cases" auth="true">
        <operation verb="get" produces="application/json">
            <service name="listSupportCasesForCustomer"/>
        </operation>
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="createSupportCaseForCustomer"/>
        </operation>
    </resource>
    <resource name="case" path="/support/cases/{supportCaseId}" auth="true">
        <operation verb="get" produces="application/json">
            <service name="getSupportCaseForCustomer"/>
        </operation>
    </resource>
    <resource name="messages" path="/support/cases/{supportCaseId}/messages" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="replySupportCaseFromCustomer"/>
        </operation>
    </resource>
    <resource name="close" path="/support/cases/{supportCaseId}/close" auth="true">
        <operation verb="post" produces="application/json">
            <service name="closeSupportCaseByCustomer"/>
        </operation>
    </resource>
    <resource name="rating" path="/support/cases/{supportCaseId}/rating" auth="true">
        <operation verb="post" consumes="application/json" produces="application/json">
            <service name="rateSupportCase"/>
        </operation>
    </resource>
    <resource name="formOptions" path="/support/form-options" auth="true">
        <operation verb="get" produces="application/json">
            <service name="getSupportCaseFormOptions"/>
        </operation>
    </resource>
    <resource name="attachments" path="/support/attachments" auth="true">
        <operation verb="post" produces="application/json">
            <service name="uploadSupportAttachment"/>
        </operation>
    </resource>
</api>
