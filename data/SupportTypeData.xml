<entity-engine-xml>

    <!-- ========================================================= -->
    <!-- Case status                                               -->
    <!-- ========================================================= -->
    <StatusType statusTypeId="SUPPORT_CASE_STATUS" description="Support case status" hasTable="N"/>
    <StatusItem statusId="SUPCS_NEW" statusTypeId="SUPPORT_CASE_STATUS" statusCode="NEW" sequenceId="01" description="New"/>
    <StatusItem statusId="SUPCS_OPEN" statusTypeId="SUPPORT_CASE_STATUS" statusCode="OPEN" sequenceId="02" description="Open"/>
    <StatusItem statusId="SUPCS_PENDING" statusTypeId="SUPPORT_CASE_STATUS" statusCode="PENDING" sequenceId="03" description="Pending customer"/>
    <StatusItem statusId="SUPCS_RESOLVED" statusTypeId="SUPPORT_CASE_STATUS" statusCode="RESOLVED" sequenceId="04" description="Resolved"/>
    <StatusItem statusId="SUPCS_CLOSED" statusTypeId="SUPPORT_CASE_STATUS" statusCode="CLOSED" sequenceId="05" description="Closed"/>
    <StatusItem statusId="SUPCS_CANCELLED" statusTypeId="SUPPORT_CASE_STATUS" statusCode="CANCELLED" sequenceId="99" description="Cancelled"/>

    <StatusValidChange statusId="SUPCS_NEW" statusIdTo="SUPCS_OPEN" transitionName="Open"/>
    <StatusValidChange statusId="SUPCS_NEW" statusIdTo="SUPCS_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="SUPCS_OPEN" statusIdTo="SUPCS_PENDING" transitionName="Wait for customer"/>
    <StatusValidChange statusId="SUPCS_OPEN" statusIdTo="SUPCS_RESOLVED" transitionName="Resolve"/>
    <StatusValidChange statusId="SUPCS_OPEN" statusIdTo="SUPCS_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="SUPCS_PENDING" statusIdTo="SUPCS_OPEN" transitionName="Resume"/>
    <StatusValidChange statusId="SUPCS_PENDING" statusIdTo="SUPCS_RESOLVED" transitionName="Resolve"/>
    <StatusValidChange statusId="SUPCS_PENDING" statusIdTo="SUPCS_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="SUPCS_RESOLVED" statusIdTo="SUPCS_CLOSED" transitionName="Close"/>
    <StatusValidChange statusId="SUPCS_RESOLVED" statusIdTo="SUPCS_OPEN" transitionName="Reopen"/>
    <StatusValidChange statusId="SUPCS_CLOSED" statusIdTo="SUPCS_OPEN" transitionName="Reopen"/>

    <!-- ========================================================= -->
    <!-- Enumerations                                              -->
    <!-- ========================================================= -->
    <EnumerationType enumTypeId="SUPPORT_CASE_TYPE" description="Support case type"/>
    <Enumeration enumId="SUPCT_INQUIRY" enumTypeId="SUPPORT_CASE_TYPE" enumCode="INQUIRY" sequenceId="01" description="Inquiry"/>
    <Enumeration enumId="SUPCT_COMPLAINT" enumTypeId="SUPPORT_CASE_TYPE" enumCode="COMPLAINT" sequenceId="02" description="Complaint"/>
    <Enumeration enumId="SUPCT_TROUBLE" enumTypeId="SUPPORT_CASE_TYPE" enumCode="TROUBLE" sequenceId="03" description="Trouble"/>
    <Enumeration enumId="SUPCT_REQUEST" enumTypeId="SUPPORT_CASE_TYPE" enumCode="REQUEST" sequenceId="04" description="Request"/>
    <Enumeration enumId="SUPCT_OTHER" enumTypeId="SUPPORT_CASE_TYPE" enumCode="OTHER" sequenceId="99" description="Other"/>

    <EnumerationType enumTypeId="SUPPORT_SOURCE" description="Support case source"/>
    <Enumeration enumId="SUPCSRC_EMAIL" enumTypeId="SUPPORT_SOURCE" enumCode="EMAIL" sequenceId="01" description="Email"/>
    <Enumeration enumId="SUPCSRC_PORTAL" enumTypeId="SUPPORT_SOURCE" enumCode="PORTAL" sequenceId="02" description="Customer portal"/>
    <Enumeration enumId="SUPCSRC_PHONE" enumTypeId="SUPPORT_SOURCE" enumCode="PHONE" sequenceId="03" description="Phone"/>
    <Enumeration enumId="SUPCSRC_LETTER" enumTypeId="SUPPORT_SOURCE" enumCode="LETTER" sequenceId="04" description="Letter"/>
    <Enumeration enumId="SUPCSRC_STAFF" enumTypeId="SUPPORT_SOURCE" enumCode="STAFF" sequenceId="05" description="Staff"/>

    <EnumerationType enumTypeId="SUPPORT_MSG_DIR" description="Support message direction"/>
    <Enumeration enumId="SUPMSG_IN" enumTypeId="SUPPORT_MSG_DIR" enumCode="IN" sequenceId="01" description="Inbound"/>
    <Enumeration enumId="SUPMSG_OUT" enumTypeId="SUPPORT_MSG_DIR" enumCode="OUT" sequenceId="02" description="Outbound"/>
    <Enumeration enumId="SUPMSG_INTERNAL" enumTypeId="SUPPORT_MSG_DIR" enumCode="INTERNAL" sequenceId="03" description="Internal note"/>

    <EnumerationType enumTypeId="SUPPORT_RESOLUTION" description="Support case resolution"/>
    <Enumeration enumId="SUPRES_ANSWERED" enumTypeId="SUPPORT_RESOLUTION" enumCode="ANSWERED" sequenceId="01" description="Answered"/>
    <Enumeration enumId="SUPRES_FIXED" enumTypeId="SUPPORT_RESOLUTION" enumCode="FIXED" sequenceId="02" description="Fixed"/>
    <Enumeration enumId="SUPRES_WORKAROUND" enumTypeId="SUPPORT_RESOLUTION" enumCode="WORKAROUND" sequenceId="03" description="Workaround"/>
    <Enumeration enumId="SUPRES_DUPLICATE" enumTypeId="SUPPORT_RESOLUTION" enumCode="DUPLICATE" sequenceId="04" description="Duplicate"/>
    <Enumeration enumId="SUPRES_REJECTED" enumTypeId="SUPPORT_RESOLUTION" enumCode="REJECTED" sequenceId="05" description="Rejected"/>
    <Enumeration enumId="SUPRES_WITHDRAWN" enumTypeId="SUPPORT_RESOLUTION" enumCode="WITHDRAWN" sequenceId="06" description="Withdrawn"/>

    <EnumerationType enumTypeId="SUPPORT_ASSIGN" description="Support assignment strategy"/>
    <Enumeration enumId="SUPASG_LEAST_LOAD" enumTypeId="SUPPORT_ASSIGN" enumCode="LEAST_LOAD" sequenceId="01" description="Least load"/>
    <Enumeration enumId="SUPASG_ROUND_ROBIN" enumTypeId="SUPPORT_ASSIGN" enumCode="ROUND_ROBIN" sequenceId="02" description="Round robin"/>
    <Enumeration enumId="SUPASG_FIXED" enumTypeId="SUPPORT_ASSIGN" enumCode="FIXED" sequenceId="03" description="Fixed assignee"/>

    <!-- ========================================================= -->
    <!-- Permissions and groups                                    -->
    <!-- ========================================================= -->
    <SecurityPermission permissionId="SUPPORT" description="Access the Support application"/>
    <SecurityPermission permissionId="SUPPORT_VIEW" description="View support cases"/>
    <SecurityPermission permissionId="SUPPORT_CREATE" description="Create support cases"/>
    <SecurityPermission permissionId="SUPPORT_UPDATE" description="Update support cases"/>
    <SecurityPermission permissionId="SUPPORT_DELETE" description="Delete support cases"/>
    <SecurityPermission permissionId="SUPPORT_ADMIN" description="Administer support cases, queues and SLAs"/>
    <SecurityPermission permissionId="SUPPORT_API" description="Use the customer support API"/>

    <SecurityGroup groupId="SUPPORT_AGENT" groupName="Support Agent" description="Support agent group"/>
    <SecurityGroup groupId="SUPPORT_MANAGER" groupName="Support Manager" description="Support manager group"/>

    <SecurityGroupPermission groupId="SUPPORT_AGENT" permissionId="SUPPORT" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_AGENT" permissionId="SUPPORT_VIEW" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_AGENT" permissionId="SUPPORT_CREATE" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_AGENT" permissionId="SUPPORT_UPDATE" fromDate="2026-10-20 00:00:00.0"/>

    <SecurityGroupPermission groupId="SUPPORT_MANAGER" permissionId="SUPPORT" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_MANAGER" permissionId="SUPPORT_VIEW" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_MANAGER" permissionId="SUPPORT_CREATE" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_MANAGER" permissionId="SUPPORT_UPDATE" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPPORT_MANAGER" permissionId="SUPPORT_DELETE" fromDate="2026-10-20 00:00:00.0"/>

    <!-- The built-in SUPER group (system and super users) can administer support. -->
    <SecurityGroupPermission groupId="SUPER" permissionId="SUPPORT" fromDate="2026-10-20 00:00:00.0"/>
    <SecurityGroupPermission groupId="SUPER" permissionId="SUPPORT_ADMIN" fromDate="2026-10-20 00:00:00.0"/>

    <!-- ========================================================= -->
    <!-- Default queues and SLA                                    -->
    <!-- ========================================================= -->
    <SupportQueue queueId="SUPPORT_DEFAULT" queueName="Default support queue"
                  description="Default queue for support cases"
                  assignStrategyEnumId="SUPASG_LEAST_LOAD"
                  active="Y" createdDate="2026-10-20 00:00:00.0" lastModifiedDate="2026-10-20 00:00:00.0"/>
    <SupportQueue queueId="SUPPORT_TRIAGE" queueName="Triage queue"
                  description="Queue for cases without a known contract or product"
                  assignStrategyEnumId="SUPASG_LEAST_LOAD"
                  active="Y" createdDate="2026-10-20 00:00:00.0" lastModifiedDate="2026-10-20 00:00:00.0"/>

    <SupportSla slaId="SUPPORT_DEFAULT_SLA" description="Default support SLA"
                firstResponseMinutes="240" resolutionMinutes="2880"
                active="Y" sequenceNum="100" fromDate="2026-10-20 00:00:00.0"/>

</entity-engine-xml>
