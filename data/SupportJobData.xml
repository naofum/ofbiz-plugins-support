<entity-engine-xml>
    <!-- STEP S6: operational jobs. The first run is the next day so that
         test/seed loads do not execute retention or notification work. -->
    <RecurrenceRule recurrenceRuleId="SUP_ESCALATE_RULE" frequency="HOURLY" intervalNumber="1" countNumber="-1"/>
    <RecurrenceInfo recurrenceInfoId="SUP_ESCALATE_INFO" startDateTime="2026-10-22 00:00:00.000"
                    recurrenceRuleId="SUP_ESCALATE_RULE" recurrenceCount="0"/>
    <JobSandbox jobId="SUP_ESCALATE" jobName="Escalate overdue support cases"
                runTime="2026-10-22 00:00:00.000" serviceName="escalateOverdueSupportCases"
                poolId="pool" runAsUser="system" recurrenceInfoId="SUP_ESCALATE_INFO"/>

    <RecurrenceRule recurrenceRuleId="SUP_ORPHAN_RULE" frequency="HOURLY" intervalNumber="1" countNumber="-1"/>
    <RecurrenceInfo recurrenceInfoId="SUP_ORPHAN_INFO" startDateTime="2026-10-22 00:15:00.000"
                    recurrenceRuleId="SUP_ORPHAN_RULE" recurrenceCount="0"/>
    <JobSandbox jobId="SUP_ORPHAN" jobName="Link orphan inbound support emails"
                runTime="2026-10-22 00:15:00.000" serviceName="linkOrphanInboundSupportEmails"
                poolId="pool" runAsUser="system" recurrenceInfoId="SUP_ORPHAN_INFO"/>

    <RecurrenceRule recurrenceRuleId="SUP_RETENTION_RULE" frequency="DAILY" intervalNumber="1" countNumber="-1"/>
    <RecurrenceInfo recurrenceInfoId="SUP_RETENTION_INFO" startDateTime="2026-10-22 02:00:00.000"
                    recurrenceRuleId="SUP_RETENTION_RULE" recurrenceCount="0"/>
    <JobSandbox jobId="SUP_RETENTION" jobName="Apply support retention rule"
                runTime="2026-10-22 02:00:00.000" serviceName="applySupportRetention"
                poolId="pool" runAsUser="system" recurrenceInfoId="SUP_RETENTION_INFO"/>
</entity-engine-xml>
