<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Support Component Services</description>
    <vendor>Apache OFBiz</vendor>
    <version>1.0</version>

    <!-- ============================================================= -->
    <!-- Permission service                                            -->
    <!-- ============================================================= -->
    <service name="supportGenericPermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportGenericPermission" auth="true">
        <description>Support generic permission checking logic</description>
        <attribute name="mainAction" type="String" mode="IN" optional="false"/>
        <attribute name="primaryPermission" type="String" mode="IN" optional="true" default-value="SUPPORT"/>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="supportApiPermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportApiPermission" auth="true">
        <description>Support customer API permission checking logic</description>
        <attribute name="mainAction" type="String" mode="IN" optional="false"/>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="supportReportPermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportReportPermission" auth="true">
        <description>Support report permission checking logic</description>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="supportAuditPermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportAuditPermission" auth="true">
        <description>Support audit log permission checking logic</description>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="supportQueuePermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportQueuePermission" auth="true">
        <description>Support queue management permission checking logic</description>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="supportSlaPermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportSlaPermission" auth="true">
        <description>Support SLA management permission checking logic</description>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="supportAdminPermission" engine="simple" default-entity-name="SupportCase"
            location="component://support/minilang/SupportPermissionServices.xml" invoke="supportAdminPermission" auth="true">
        <description>Support administrator permission checking logic</description>
        <attribute name="hasPermission" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="failMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- Case lifecycle                                                -->
    <!-- ============================================================= -->
    <service name="createSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="createSupportCase" auth="true">
        <description>Create a support case. The initial status is always SUPCS_NEW.</description>
        <permission-service service-name="supportGenericPermission" main-action="CREATE"/>
        <auto-attributes include="nonpk" mode="IN" optional="true">
            <exclude field-name="isDeleted"/>
            <exclude field-name="deletedAt"/>
            <exclude field-name="deletedByUserLogin"/>
            <exclude field-name="anonymizedAt"/>
        </auto-attributes>
        <attribute name="supportCaseId" type="String" mode="OUT" optional="true"/>
        <override name="subject" allow-html="safe"/>
        <override name="description" allow-html="safe"/>
        <override name="satisfactionComment" allow-html="safe"/>
    </service>

    <service name="updateSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="updateSupportCase" auth="true">
        <description>Update the editable fields of a support case. The status is not changed here.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true">
            <exclude field-name="isDeleted"/>
            <exclude field-name="deletedAt"/>
            <exclude field-name="deletedByUserLogin"/>
            <exclude field-name="anonymizedAt"/>
        </auto-attributes>
        <override name="subject" allow-html="safe"/>
        <override name="description" allow-html="safe"/>
        <override name="satisfactionComment" allow-html="safe"/>
    </service>

    <service name="assignSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="assignSupportCase" auth="true">
        <description>Assign a support case to a queue and/or an agent.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="queueId" type="String" mode="IN" optional="true"/>
        <attribute name="assigneePartyId" type="String" mode="IN" optional="true"/>
    </service>

    <service name="changeSupportCaseStatus" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="changeSupportCaseStatus" auth="true">
        <description>Change the status through an allowed StatusValidChange.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="statusId" type="String" mode="IN" optional="false"/>
        <attribute name="resolutionEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <override name="note" allow-html="safe"/>
    </service>

    <service name="resolveSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="resolveSupportCase" auth="true">
        <description>Resolve a support case and record the resolution code.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="resolutionEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <override name="note" allow-html="safe"/>
    </service>

    <service name="closeSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="closeSupportCase" auth="true">
        <description>Close a resolved support case.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="note" type="String" mode="IN" optional="true"/>
        <override name="note" allow-html="safe"/>
    </service>

    <service name="reopenSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="reopenSupportCase" auth="true">
        <description>Reopen a resolved or closed support case.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="reason" type="String" mode="IN" optional="true"/>
        <override name="reason" allow-html="safe"/>
    </service>

    <service name="getSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="getSupportCase" auth="true">
        <description>Get a support case with its status history and linked messages.</description>
        <permission-service service-name="supportGenericPermission" main-action="VIEW"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="supportCase" type="GenericValue" mode="OUT" optional="true"/>
        <attribute name="supportCaseStatuses" type="List" mode="OUT" optional="true"/>
        <attribute name="supportCaseMessages" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="findSupportCases" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="findSupportCases" auth="true">
        <description>Find support cases with simple filters.</description>
        <permission-service service-name="supportGenericPermission" main-action="VIEW"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="true"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="true"/>
        <attribute name="statusId" type="String" mode="IN" optional="true"/>
        <attribute name="assigneePartyId" type="String" mode="IN" optional="true"/>
        <attribute name="queueId" type="String" mode="IN" optional="true"/>
        <attribute name="financeContractId" type="String" mode="IN" optional="true"/>
        <attribute name="productId" type="String" mode="IN" optional="true"/>
        <attribute name="subject" type="String" mode="IN" optional="true"/>
        <attribute name="viewIndex" type="Integer" mode="IN" optional="true"/>
        <attribute name="viewSize" type="Integer" mode="IN" optional="true"/>
        <attribute name="supportCases" type="List" mode="OUT" optional="true"/>
        <attribute name="caseCount" type="Integer" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP S2: messages, thread and inbound email                   -->
    <!-- ============================================================= -->
    <service name="addSupportCaseMessage" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="addSupportCaseMessage" auth="true">
        <description>Link an existing CommunicationEvent to a support case.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="communicationEventId" type="String" mode="IN" optional="false"/>
        <attribute name="directionEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="isInternal" type="Boolean" mode="IN" optional="true"/>
    </service>

    <service name="addSupportCaseInternalNote" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="addSupportCaseInternalNote" auth="true">
        <description>Create an internal COMMENT_NOTE and link it to a support case.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="subject" type="String" mode="IN" optional="true"/>
        <attribute name="content" type="String" mode="IN" optional="false"/>
        <attribute name="communicationEventId" type="String" mode="OUT" optional="true"/>
        <override name="content" allow-html="any"/>
    </service>

    <service name="replySupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="replySupportCase" auth="true">
        <description>Create an outbound email reply, link it to the case and queue it for sending.</description>
        <permission-service service-name="supportGenericPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="subject" type="String" mode="IN" optional="true"/>
        <attribute name="content" type="String" mode="IN" optional="false"/>
        <attribute name="sendNow" type="Boolean" mode="IN" optional="true"/>
        <attribute name="communicationEventId" type="String" mode="OUT" optional="true"/>
        <override name="content" allow-html="any"/>
        <override name="subject" allow-html="safe"/>
    </service>

    <service name="getSupportCaseThread" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="getSupportCaseThread" auth="true">
        <description>Get the linked messages as a chronological thread with depth and visibility flags.</description>
        <permission-service service-name="supportGenericPermission" main-action="VIEW"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="supportCaseThread" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="routeInboundSupportCommunication" engine="java"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="routeInboundSupportCommunication" auth="true">
        <description>Route an inbound AUTO_EMAIL_COMM event to a support case (ECA or reconciliation job).</description>
        <attribute name="communicationEventId" type="String" mode="IN" optional="false"/>
        <attribute name="force" type="Boolean" mode="IN" optional="true"/>
        <attribute name="autoAck" type="String" mode="IN" optional="true"/>
        <attribute name="supportCaseId" type="String" mode="OUT" optional="true"/>
        <attribute name="caseCreated" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="messageLinked" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="autoAckCommunicationEventId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="linkOrphanInboundSupportEmails" engine="java"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="linkOrphanInboundSupportEmails" auth="true">
        <description>Re-process inbound emails that were not linked to a support case.</description>
        <attribute name="processedCount" type="Integer" mode="OUT" optional="true"/>
    </service>

    <service name="escalateOverdueSupportCases" engine="java"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="escalateOverdueSupportCases" auth="true">
        <description>Escalate cases whose first response or resolution SLA is overdue.</description>
        <attribute name="escalatedCount" type="Integer" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP S4: customer portal API                                  -->
    <!-- ============================================================= -->
    <service name="createSupportCaseForCustomer" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="createSupportCaseForCustomer" auth="true">
        <description>Create a support case for a customer (API).</description>
        <permission-service service-name="supportApiPermission" main-action="CREATE"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="caseTypeEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="financeContractId" type="String" mode="IN" optional="true"/>
        <attribute name="applicationTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="applicationId" type="String" mode="IN" optional="true"/>
        <attribute name="productId" type="String" mode="IN" optional="true"/>
        <attribute name="subject" type="String" mode="IN" optional="false"/>
        <attribute name="description" type="String" mode="IN" optional="true"/>
        <attribute name="externalId" type="String" mode="IN" optional="true"/>
        <attribute name="supportCaseId" type="String" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
        <attribute name="firstResponseDueAt" type="Timestamp" mode="OUT" optional="true"/>
        <attribute name="resolutionDueAt" type="Timestamp" mode="OUT" optional="true"/>
        <override name="subject" allow-html="safe"/>
        <override name="description" allow-html="safe"/>
    </service>

    <service name="listSupportCasesForCustomer" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="listSupportCasesForCustomer" auth="true">
        <description>List the customer's own support cases (API).</description>
        <permission-service service-name="supportApiPermission" main-action="VIEW"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="statusIds" type="List" mode="IN" optional="true"/>
        <attribute name="financeContractId" type="String" mode="IN" optional="true"/>
        <attribute name="productId" type="String" mode="IN" optional="true"/>
        <attribute name="viewIndex" type="Integer" mode="IN" optional="true"/>
        <attribute name="viewSize" type="Integer" mode="IN" optional="true"/>
        <attribute name="supportCases" type="List" mode="OUT" optional="true"/>
        <attribute name="caseCount" type="Integer" mode="OUT" optional="true"/>
    </service>

    <service name="getSupportCaseForCustomer" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="getSupportCaseForCustomer" auth="true">
        <description>Get the customer's own support case with customer-visible messages (API).</description>
        <permission-service service-name="supportApiPermission" main-action="VIEW"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="supportCase" type="Map" mode="OUT" optional="true"/>
        <attribute name="messages" type="List" mode="OUT" optional="true"/>
        <attribute name="canReply" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="canClose" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="canRate" type="Boolean" mode="OUT" optional="true"/>
    </service>

    <service name="replySupportCaseFromCustomer" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="replySupportCaseFromCustomer" auth="true">
        <description>Add a customer message to a support case (API).</description>
        <permission-service service-name="supportApiPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="subject" type="String" mode="IN" optional="true"/>
        <attribute name="content" type="String" mode="IN" optional="false"/>
        <attribute name="externalId" type="String" mode="IN" optional="true"/>
        <attribute name="communicationEventId" type="String" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
        <override name="subject" allow-html="safe"/>
        <override name="content" allow-html="any"/>
    </service>

    <service name="closeSupportCaseByCustomer" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="closeSupportCaseByCustomer" auth="true">
        <description>Close or withdraw the customer's own support case (API).</description>
        <permission-service service-name="supportApiPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="reason" type="String" mode="IN" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="true"/>
        <override name="reason" allow-html="safe"/>
    </service>

    <service name="rateSupportCase" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="rateSupportCase" auth="true">
        <description>Rate a resolved support case (API).</description>
        <permission-service service-name="supportApiPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="satisfactionScore" type="String" mode="IN" optional="false"/>
        <attribute name="satisfactionComment" type="String" mode="IN" optional="true"/>
        <override name="satisfactionComment" allow-html="safe"/>
    </service>

    <service name="getSupportCaseFormOptions" engine="java"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="getSupportCaseFormOptions" auth="true">
        <description>Get the contracts, products, applications and case types for the customer (API).</description>
        <permission-service service-name="supportApiPermission" main-action="VIEW"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="contracts" type="List" mode="OUT" optional="true"/>
        <attribute name="products" type="List" mode="OUT" optional="true"/>
        <attribute name="applications" type="List" mode="OUT" optional="true"/>
        <attribute name="caseTypes" type="List" mode="OUT" optional="true"/>
    </service>

    <service name="uploadSupportAttachment" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.casemgmt.SupportCaseServices" invoke="uploadSupportAttachment" auth="true">
        <description>Upload an attachment for a customer-visible support message (API).</description>
        <permission-service service-name="supportApiPermission" main-action="UPDATE"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
        <attribute name="customerPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="communicationEventId" type="String" mode="IN" optional="true"/>
        <attribute name="fileName" type="String" mode="IN" optional="true"/>
        <attribute name="contentType" type="String" mode="IN" optional="true"/>
        <attribute name="uploadedFile" type="java.nio.ByteBuffer" mode="IN" optional="false"/>
        <attribute name="contentId" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- Queue and SLA administration                                 -->
    <!-- ============================================================= -->
    <service name="createSupportQueue" engine="entity-auto" invoke="create"
            default-entity-name="SupportQueue" auth="true">
        <description>Create a support queue.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="updateSupportQueue" engine="entity-auto" invoke="update"
            default-entity-name="SupportQueue" auth="true">
        <description>Update a support queue.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="createSupportQueueMember" engine="entity-auto" invoke="create"
            default-entity-name="SupportQueueMember" auth="true">
        <description>Add a member to a support queue.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="updateSupportQueueMember" engine="entity-auto" invoke="update"
            default-entity-name="SupportQueueMember" auth="true">
        <description>Update a support queue member.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="removeSupportQueueMember" engine="entity-auto" invoke="delete"
            default-entity-name="SupportQueueMember" auth="true">
        <description>Remove a member from a support queue.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>

    <service name="createSupportQueueProduct" engine="entity-auto" invoke="create"
            default-entity-name="SupportQueueProduct" auth="true">
        <description>Map a queue to a product, financial product type or contract type.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="removeSupportQueueProduct" engine="entity-auto" invoke="delete"
            default-entity-name="SupportQueueProduct" auth="true">
        <description>Remove a queue product mapping.</description>
        <permission-service service-name="supportQueuePermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>

    <service name="createSupportSla" engine="entity-auto" invoke="create"
            default-entity-name="SupportSla" auth="true">
        <description>Create a support SLA rule.</description>
        <permission-service service-name="supportSlaPermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="updateSupportSla" engine="entity-auto" invoke="update"
            default-entity-name="SupportSla" auth="true">
        <description>Update a support SLA rule.</description>
        <permission-service service-name="supportSlaPermission"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP S6: audit, retention and operational access              -->
    <!-- ============================================================= -->
    <service name="logSupportCaseAccess" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.audit.SupportAuditServices" invoke="logSupportCaseAccess" auth="true">
        <description>Record that a staff member viewed a support case.</description>
        <permission-service service-name="supportGenericPermission" main-action="VIEW"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="false"/>
    </service>

    <service name="findSupportAuditLogs" engine="java" default-entity-name="SupportCase"
            location="org.apache.ofbiz.support.audit.SupportAuditServices" invoke="findSupportAuditLogs" auth="true">
        <description>Find support audit log entries (manager/admin only).</description>
        <permission-service service-name="supportAuditPermission"/>
        <attribute name="supportCaseId" type="String" mode="IN" optional="true"/>
        <attribute name="actionEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="actorUserLoginId" type="String" mode="IN" optional="true"/>
        <attribute name="fromDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="thruDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="auditLogs" type="List" mode="OUT" optional="true"/>
